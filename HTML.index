<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Rock Paper Scissors</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap">
<style>
/* Layout: one match table. Two hands face off either side of a scoreboard, throw buttons underneath, round log and opponent read below. */
:root {
  --bg: #E7ECE4;
  --surface: #F5F7F1;
  --ink: #151A16;
  --muted: #566058;
  --line: #C3CCC0;
  --win: #1D6B55;
  --win-tint: #CFE6DC;
  --lose: #B0402B;
  --lose-tint: #F1D6CD;
  --draw: #6C746D;
  --accent: #C9731C;
  --font-display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", sans-serif;
  --font-body: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #101411;
    --surface: #192019;
    --ink: #E6ECE3;
    --muted: #9AA79C;
    --line: #2B352C;
    --win: #6FD0AC;
    --win-tint: #1C3A2F;
    --lose: #EE8A74;
    --lose-tint: #43211A;
    --draw: #8E998F;
    --accent: #F0A24B;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #101411;
  --surface: #192019;
  --ink: #E6ECE3;
  --muted: #9AA79C;
  --line: #2B352C;
  --win: #6FD0AC;
  --win-tint: #1C3A2F;
  --lose: #EE8A74;
  --lose-tint: #43211A;
  --draw: #8E998F;
  --accent: #F0A24B;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  padding-block: 22px 48px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 860px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
button { font: inherit; color: inherit; cursor: pointer; }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

/* Header */
header { display: flex; flex-direction: column; gap: 6px; }
h1 {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(1.9rem, 6.5vw, 3rem);
  line-height: 1;
  letter-spacing: -0.02em;
  margin: 0;
  text-wrap: balance;
}
.tagline { margin: 0; color: var(--muted); max-width: 52ch; }

.controls { display: flex; flex-wrap: wrap; gap: 14px 28px; }
.field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
.seg { display: inline-flex; border: 1.5px solid var(--ink); border-radius: 8px; overflow: hidden; background: var(--surface); }
.seg button { border: 0; background: transparent; padding: 8px 14px; font-weight: 500; min-height: 40px; }
.seg button + button { border-left: 1.5px solid var(--ink); }
.seg button[aria-pressed="true"] { background: var(--ink); color: var(--surface); }
.seg button:not([aria-pressed="true"]):hover { background: var(--line); }

/* Arena */
.arena { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: stretch; }
.side {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: 14px;
  padding: 14px 12px 16px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  min-width: 0;
  transition: background 0.2s, border-color 0.2s, opacity 0.2s;
